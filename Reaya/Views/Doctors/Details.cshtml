@model Doctor
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Doctor Details – Rayaah Clinic</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/dashboard.css" />
    <style>
        .details-grid {
            display: grid;
            grid-template-columns: 1fr 340px;
            gap: 24px;
            align-items: start;
        }
        .hero-banner {
            background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
            border: 1px solid #e8edf3;
            border-radius: 20px;
            padding: 24px 28px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 2px 12px rgba(15,23,42,0.04);
            margin-bottom: 24px;
        }
        .info-card {
            background: linear-gradient(135deg, #ffffff, #f8fafc);
            border: 1px solid #e8edf3;
            border-radius: 20px;
            padding: 28px;
            box-shadow: 0 4px 16px rgba(15,23,42,0.04);
            margin-bottom: 24px;
            position: relative;
            overflow: hidden;
            transition: all 0.3s ease;
        }
        .info-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, #0ea5e9, #0369a1);
            opacity: 0;
            transition: opacity 0.3s ease;
        }
        .info-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(15,23,42,0.08);
        }
        .info-card:hover::before {
            opacity: 1;
        }
        .info-card h3 {
            font-size: 15px;
            font-weight: 800;
            color: #0f172a;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .data-grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }
        .data-item label {
            display: block;
            font-size: 11px;
            font-weight: 700;
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 4px;
        }
        .data-item span {
            font-size: 14px;
            font-weight: 700;
            color: #1e293b;
        }
    </style>
</head>
<body>
<div class="shell">

    @Html.Partial("_Sidebar")

    <!-- Main -->
    <div class="main">
      <header class="topbar">
    <form method="get" asp-controller="Doctors" asp-action="Index" style="flex-grow: 1; display: flex;">
        <div class="search-bar" style="width: 100%;">
            <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 5 5"/></svg>
            <input type="search" name="search" value="@Context.Request.Query["search"]" placeholder="Search doctors..." style="width: 100%; border: none; outline: none; background: transparent;" onchange="this.form.submit()" />
        </div>
    </form>
   
      </header>

      <div class="content">
        <!-- Navigation Back Button -->
        <div style="margin-bottom: 12px;">
            <a asp-controller="Doctors" asp-action="Index" style="text-decoration:none; font-size:13px; font-weight:700; color:#0284c7; display:inline-flex; align-items:center; gap:6px;">
                <i class="bi bi-arrow-left"></i> Back to Doctors
            </a>
        </div>

        @{
            string initials = "DR";
            if (!string.IsNullOrEmpty(Model.Name))
            {
                var nameParts = Model.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                if (nameParts.Length >= 2)
                {
                    initials = $"{char.ToUpper(nameParts[0][0])}{char.ToUpper(nameParts[1][0])}";
                }
                else if (nameParts.Length == 1)
                {
                    initials = nameParts[0].Substring(0, Math.Min(2, nameParts[0].Length)).ToUpper();
                }
            }
        }

        <!-- Top Hero Banner with Doctor Title and Actions -->
        <div class="hero-banner">
            <div style="display:flex; align-items:center; gap:18px;">
                @if (!string.IsNullOrEmpty(Model.ImagePath))
                {
                    <div style="width:58px; height:58px; border-radius:16px; overflow:hidden;">
                        <img src="@(Model.ImagePath.Replace("\\", "/"))" alt="@Model.Name" style="width:100%;height:100%;object-fit:cover;" />
                    </div>
                }
                else
                {
                    <div style="width:58px; height:58px; border-radius:16px; overflow:hidden;">
                        <img src="~/images/user_default.jpg" alt="@Model.Name" style="width:100%;height:100%;object-fit:cover;" />
                    </div>
                }
                <div>
                    <div style="display:flex; align-items:center; gap:12px; margin-bottom:4px;">
                        <h1 style="font-size:22px; font-weight:800; color:#0f172a; margin:0;"><span>Dr.</span>@Model.Name</h1>
                        <span style="display:inline-flex; align-items:center; gap:4px; padding:3px 10px; border-radius:12px; background:#dcfce7; color:#15803d; font-size:11px; font-weight:700;">
                            <i class="bi bi-check-circle-fill"></i> Active Staff
                        </span>
                    </div>
                    <p style="font-size:13px; color:#64748b; margin:0;">@Model.Specialization · Rayaah Clinic</p>
                </div>
            </div>
            <div style="display:flex; gap:10px;">
                <a asp-controller="Doctors" asp-action="Edit" asp-route-id="@Model.Id" class="reschedule-btn" style="text-decoration:none; height:42px; padding:0 20px; font-size:13px; background:#f0f9ff; border-color:#bae6fd; color:#0369a1; display:inline-flex; align-items:center; gap:6px;">
                    <i class="bi bi-pencil-square"></i> Edit Profile
                </a>
            </div>
        </div>

        <!-- Details Grid (Left main cards + Right sidebar cards) -->
        <div class="details-grid">

            <!-- Left Column -->
            <div>
                <!-- Professional Information Card -->
                <div class="info-card">
                    <h3><i class="bi bi-person-circle" style="color:#0ea5e9;"></i> Professional Information</h3>
                    <div style="display:flex; align-items:center; gap:16px; margin-bottom:20px; padding-bottom:16px; border-bottom:1px solid #f1f5f9;">
                        @if (!string.IsNullOrEmpty(Model.ImagePath))
                        {
                            <div style="width:48px; height:48px; border-radius:50%; overflow:hidden;">
                                <img src="@(Model.ImagePath.Replace("\\", "/"))" alt="@Model.Name" style="width:100%;height:100%;object-fit:cover;" />
                            </div>
                        }
                        else
                        {
                            <div style="width:48px; height:48px; border-radius:50%; overflow:hidden;">
                                <img src="~/images/user_default.jpg" alt="@Model.Name" style="width:100%;height:100%;object-fit:cover;" />
                            </div>
                        }
                        <div>
                            <h4 style="font-size:16px; font-weight:800; color:#0f172a; margin:0;"><span>Dr.</span>@Model.Name</h4>
                            <span style="font-size:12px; color:#64748b;">Doctor ID: #@Model.Id</span>
                        </div>
                    </div>

                    <div class="data-grid-2">
                        <div class="data-item">
                            <label>Specialization</label>
                            <span>@Model.Specialization</span>
                        </div>
                        <div class="data-item">
                            <label>Years of Experience</label>
                            <span>@Model.yearsExperience Years</span>
                        </div>
                    </div>
                </div>

                <!-- Contact Information Card -->
                <div class="info-card">
                    <h3><i class="bi bi-envelope-at" style="color:#0ea5e9;"></i> Contact Information</h3>
                    <div class="data-grid-2">
                        <div class="data-item">
                            <label>Email Address</label>
                            <span>@Model.Email</span>
                        </div>
                        <div class="data-item">
                            <label>Phone Number</label>
                            <span>@Model.Phone</span>
                        </div>
                    </div>
                </div>

                <!-- Biography Card -->
                <div class="info-card">
                    <h3><i class="bi bi-journal-medical" style="color:#0ea5e9;"></i> Biography</h3>
                    <div style="background:#f8fafc; border:1.5px solid #e2e8f0; border-radius:12px; padding:16px; font-size:13px; color:#334155; line-height:1.6;">
                        @Model.Biography
                    </div>
                </div>
            </div>

            <!-- Right Column (Sidebar Summary Cards) -->
            <div>
                <!-- Quick Stats Card -->
                <div class="info-card">
                    <h3><i class="bi bi-activity" style="color:#0ea5e9;"></i> Quick Stats</h3>
                    <div style="display:flex; flex-direction:column; gap:12px;">
                        <div class="data-item">
                            <label>Consultation Fee</label>
                            <span style="color:#15803d; font-size:16px; font-weight:800;">
                                @Model.ConsultationFee EGP
                            </span>
                        </div>
                        <div class="data-item">
                            <label>Patient Rating</label>
                            <span style="color:#f59e0b;">
                                <i class="bi bi-star-fill"></i> 4.9
                            </span>
                        </div>
                    </div>
                </div>
            </div>

        </div>

      </div>
    </div>

</div>
</body>
</html>
