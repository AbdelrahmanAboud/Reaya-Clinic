@{
    var upcomingAppointments = ViewBag.UpcomingAppointments as List<Appointment>;
    var pastAppointments = ViewBag.PastAppointments as List<Appointment>;
    var patient = ViewBag.Patient as Patient;
    string initials = "PT";
    if (!string.IsNullOrEmpty(patient?.Name))
    {
        var nameParts = patient.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (nameParts.Length >= 2)
        {
            initials = $"{char.ToUpper(nameParts[0][0])}{char.ToUpper(nameParts[1][0])}";
        }
        else if (nameParts.Length == 1)
        {
            initials = nameParts[0].Substring(0, Math.Min(2, nameParts[0].Length)).ToUpper();
        }
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Appointments - Patient Portal</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/dashboard.css" />
</head>
<body>
<div class="shell">

    <!-- Sidebar -->
    @Html.Partial("_Sidebar")

    <!-- Main -->
    <div class="main">
      <header class="topbar">
    <div style="flex-grow: 1;"></div>
    
</header>

        <div class="content">

            <!-- Page header -->
            <div class="page-header">
                <div>
                    <h1>My Appointments</h1>
                    <p>Manage your upcoming and past appointments</p>
                </div>
                <a class="new-apt-btn" href="/PatientPortal/BookAppointment">+ Book new appointment</a>
            </div>

            <!-- Upcoming Appointments -->
            <div class="card" style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02); margin-top: 20px; overflow: hidden;">
    <div class="card-header" style="display: flex; justify-content: space-between; align-items: center; padding: 20px 24px; border-bottom: 1px solid #f1f5f9;">
        <h2 style="font-size: 18px; font-weight: 600; color: #0f172a; margin: 0;">Upcoming appointments</h2>
    </div>
    
    @if (upcomingAppointments != null && upcomingAppointments.Any())
    {
        <div style="display: flex; flex-direction: column; gap: 12px; padding: 16px 24px;">
            @foreach (var appointment in upcomingAppointments)
            {
                string statusBadgeBg = "#e0f2fe";
                string statusBadgeColor = "#0284c7";
                if (appointment.Status == AppointmentStatus.Pending) { statusBadgeBg = "#fef3c7"; statusBadgeColor = "#d97706"; }
                else if (appointment.Status == AppointmentStatus.Confirmed) { statusBadgeBg = "#dcfce7"; statusBadgeColor = "#15803d"; }

                <div style="display: flex; align-items: center; gap: 16px; padding: 16px; border-radius: 12px; background: #f8fafc; border: 1px solid #e2e8f0;">
                    <div style="display: grid; width: 48px; height: 48px; place-items: center; border-radius: 12px; background: linear-gradient(135deg, #0284c7, #0369a1); color: white; font-weight: 700; font-size: 18px; flex-shrink: 0;">
                        DR
                    </div>
                    <div style="flex: 1; min-width: 0;">
                        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
                            <strong style="color: #0f172a; font-size: 15px; font-weight: 700;">Dr. @appointment.Doctor?.Name</strong>
                            <span style="display: inline-flex; align-items: center; gap: 4px; padding: 4px 12px; border-radius: 20px; font-size: 11px; font-weight: 600; background-color: @statusBadgeBg; color: @statusBadgeColor;">
                                @appointment.Status.ToString()
                            </span>
                        </div>
                       <div style="display: flex; align-items: center; gap: 16px; color: #64748b; font-size: 13px;">
    <span><i class="bi bi-calendar3" style="margin-right: 4px;"></i>@appointment.AppointmentDate.ToString("MMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture)</span>
    <span><i class="bi bi-clock" style="margin-right: 4px;"></i>@appointment.AppointmentDate.ToString("hh:mm tt", System.Globalization.CultureInfo.InvariantCulture)</span>
    <span><i class="bi bi-briefcase" style="margin-right: 4px;"></i>@appointment.Doctor?.Specialization</span>
</div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div style="text-align: center; color: #94a3b8; padding: 40px;">
            <i class="bi bi-calendar-x" style="font-size: 48px; margin-bottom: 12px;"></i>
            <p>No upcoming appointments</p>
        </div>
    }
</div>

            <!-- Past Appointments -->
            <div class="card" style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02); margin-top: 20px; overflow: hidden;">
    <div class="card-header" style="display: flex; justify-content: space-between; align-items: center; padding: 20px 24px; border-bottom: 1px solid #f1f5f9;">
        <h2 style="font-size: 18px; font-weight: 600; color: #0f172a; margin: 0;">Past appointments</h2>
    </div>
    
    @if (pastAppointments != null && pastAppointments.Any())
    {
        <div style="display: flex; flex-direction: column; gap: 12px; padding: 16px 24px;">
            @foreach (var appointment in pastAppointments.Take(5))
            {
                <div style="display: flex; align-items: center; gap: 16px; padding: 16px; border-radius: 12px; background: #f8fafc; border: 1px solid #e2e8f0;">
                    <div style="display: grid; width: 48px; height: 48px; place-items: center; border-radius: 12px; background: linear-gradient(135deg, #64748b, #475569); color: white; font-weight: 700; font-size: 18px; flex-shrink: 0;">
                        DR
                    </div>
                    <div style="flex: 1; min-width: 0;">
                        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
                            <strong style="color: #0f172a; font-size: 15px; font-weight: 700;">Dr. @appointment.Doctor?.Name</strong>
                            <span style="display: inline-flex; align-items: center; gap: 4px; padding: 4px 12px; border-radius: 20px; font-size: 11px; font-weight: 600; background-color: #dcfce7; color: #15803d;">
                                @appointment.Status.ToString()
                            </span>
                        </div>
                       <div style="display: flex; align-items: center; gap: 16px; color: #64748b; font-size: 13px;">
    <span><i class="bi bi-calendar3" style="margin-right: 4px;"></i>@appointment.AppointmentDate.ToString("MMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture)</span>
    <span><i class="bi bi-clock" style="margin-right: 4px;"></i>@appointment.AppointmentDate.ToString("hh:mm tt", System.Globalization.CultureInfo.InvariantCulture)</span>
    <span><i class="bi bi-briefcase" style="margin-right: 4px;"></i>@appointment.Doctor?.Specialization</span>
</div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div style="text-align: center; color: #94a3b8; padding: 40px;">
            <i class="bi bi-calendar-x" style="font-size: 48px; margin-bottom: 12px;"></i>
            <p>No past appointments</p>
        </div>
    }
</div>

        </div>
    </div>

</div>
</body>
</html>