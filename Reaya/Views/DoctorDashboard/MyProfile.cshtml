@model Doctor
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "My Profile";
    
    string initials = "DR";
    if (!string.IsNullOrEmpty(Model?.Name))
    {
        var nameParts = Model.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (nameParts.Length >= 2)
        {
            initials = $"{char.ToUpper(nameParts[0][0])}{char.ToUpper(nameParts[1][0])}";
        }
        else if (nameParts.Length == 1)
        {
            initials = nameParts[0].Substring(0, Math.Min(2, nameParts[0].Length)).ToUpper();
        }
    }
    
    string doctorImagePath = Model?.ImagePath;
    bool hasImage = false;
    
    if (!string.IsNullOrEmpty(doctorImagePath) && doctorImagePath != "\\images\\user_default.jpg")
    {
        doctorImagePath = doctorImagePath.Replace("\\", "/");
        hasImage = true;
    }
    else
    {
        doctorImagePath = null; // Will use initials instead
        hasImage = false;
    }
}

@section AdditionalStyles {
<style>
        .profile-section {
            background: linear-gradient(135deg, #0ea5e9 0%, #0369a1 100%);
            padding: 40px 24px;
            border-radius: 16px;
            margin-bottom: 24px;
            position: relative;
            overflow: hidden;
        }
        
        .profile-section::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
        }
        
        .profile-avatar {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            background: linear-gradient(135deg, #ffffff, #f0f0f0);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 42px;
            font-weight: 700;
            color: #0ea5e9;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
            position: relative;
            z-index: 1;
            overflow: hidden;
            border: 4px solid rgba(255, 255, 255, 0.3);
            cursor: pointer;
            transition: transform 0.3s ease;
        }
        
        .profile-avatar:hover {
            transform: scale(1.05);
        }
        
        .profile-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 50%;
        }
        
        .profile-avatar-edit {
            position: absolute;
            bottom: 0;
            right: 0;
            width: 36px;
            height: 36px;
            background: #0ea5e9;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 16px;
            cursor: pointer;
            border: 3px solid white;
            transition: background 0.3s ease;
        }
        
        .profile-avatar-edit:hover {
            background: #0369a1;
        }
        
        .profile-info {
            position: relative;
            z-index: 1;
        }
        
        .profile-info h2 {
            color: white;
            font-size: 26px;
            font-weight: 700;
            margin: 0 0 8px 0;
        }
        
        .profile-info p {
            color: rgba(255, 255, 255, 0.9);
            font-size: 15px;
            margin: 0;
        }
        
        .info-card {
            background: white;
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            border: 1px solid #e8ecf4;
            overflow: hidden;
        }
        
        .info-card-header {
            background: linear-gradient(135deg, #f8f9fa, #e9ecef);
            padding: 20px 24px;
            border-bottom: 1px solid #e8ecf4;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        
        .info-card-header h3 {
            margin: 0;
            font-size: 18px;
            font-weight: 600;
            color: #2d3748;
        }
        
        .info-card-header i {
            font-size: 20px;
            color: #0ea5e9;
        }
        
        .form-section {
            padding: 24px;
        }
        
        .form-section-title {
            font-size: 16px;
            font-weight: 600;
            color: #4a5568;
            margin: 24px 0 16px 0;
            padding-bottom: 12px;
            border-bottom: 2px solid #e8ecf4;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .form-section-title i {
            color: #0ea5e9;
        }
        
        .form-group {
            margin-bottom: 20px;
        }
        
        .form-label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            color: #4a5568;
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        
        .form-control {
            width: 100%;
            padding: 12px 16px;
            border: 2px solid #e8ecf4;
            border-radius: 10px;
            font-size: 14px;
            color: #2d3748;
            background: #f8f9fa;
            transition: all 0.3s ease;
            outline: none;
        }
        
        .form-control:focus {
            border-color: #0ea5e9;
            background: white;
            box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.1);
        }
        
        .form-control:hover {
            border-color: #cbd5e0;
        }
        
        .btn-primary {
            background: linear-gradient(135deg, #0ea5e9 0%, #0369a1 100%);
            color: white;
            border: none;
            padding: 14px 28px;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(14, 165, 233, 0.3);
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }
        
        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(14, 165, 233, 0.4);
        }
        
        .btn-primary:active {
            transform: translateY(0);
        }
        
        .success-message {
            background: linear-gradient(135deg, #d4edda, #c3e6cb);
            border: 1px solid #b8e9c0;
            color: #155724;
            padding: 16px 20px;
            border-radius: 12px;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            gap: 12px;
            box-shadow: 0 4px 12px rgba(40, 167, 69, 0.15);
        }
        
        .error-message {
            background: linear-gradient(135deg, #f8d7da, #f5c6cb);
            border: 1px solid #f5c6cb;
            color: #721c24;
            padding: 16px 20px;
            border-radius: 12px;
            margin-top: 20px;
            box-shadow: 0 4px 12px rgba(220, 53, 69, 0.15);
        }
        
        .error-message ul {
            margin: 0;
            padding-left: 20px;
        }
        
        .input-group {
            position: relative;
        }
        
        .input-group .form-control {
            padding-right: 45px;
        }
        
        .input-group-icon {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #a0aec0;
            font-size: 16px;
            pointer-events: none;
        }
        
        .password-optional {
            font-size: 12px;
            color: #718096;
            margin-top: 4px;
            font-style: italic;
        }
    </style>
}

<div class="content">

            <!-- Page header -->
            <div class="page-header">
            <div>
    <h1>My Profile</h1>
    <p>Manage your personal information and account settings</p>
</div>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="success-message">
                    <i class="bi bi-check-circle-fill" style="font-size: 20px;"></i>
                    <span>@TempData["SuccessMessage"]</span>
                </div>
            }

            <!-- Single Form Card -->
            <div class="info-card">
                <div class="profile-section">
                    <div style="display: flex; align-items: center; gap: 24px;">
                        <div class="profile-avatar" onclick="document.getElementById('imageInput').click()">
                            @if (hasImage)
                            {
                                <img src="/images/@System.IO.Path.GetFileName(Model?.ImagePath)" alt="@Model?.Name" onerror="this.style.display='none'; this.parentElement.querySelector('span').style.display='block';" />
                                <span style="display: none;">@initials</span>
                            }
                            else
                            {
                                <span>@initials</span>
                            }
                          
                        </div>
                        <input type="file" id="imageInput" name="ImageFile" accept="image/*" style="display: none;" onchange="previewImage(this)" />
                        <div class="profile-info">
                            <h2>@Model?.Name</h2>
                            <p>@Model?.Specialization</p>
                            <p style="margin-top: 4px; opacity: 0.8;">
                                <i class="bi bi-geo-alt" style="margin-right: 4px;"></i>Reaya Clinic
                            </p>
                        </div>
                    </div>
                </div>
                
                <div class="info-card-header">
                    <i class="bi bi-person-gear"></i>
                    <h3>Profile Settings</h3>
                </div>
                
                <form method="post" asp-action="UpdateProfile" style="padding: 24px;">
                    @Html.AntiForgeryToken()
                    
                    <!-- Personal Information Section -->
                    <div class="form-section-title">
                        <i class="bi bi-person"></i>
                        Personal Information
                    </div>
                    
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                        <div class="form-group">
                            <label class="form-label">Full Name</label>
                            <div class="input-group">
                                <input type="text" name="Name" value="@Model?.Name" class="form-control" placeholder="Enter your full name" />
                                <i class="bi bi-person input-group-icon"></i>
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Email Address</label>
                            <div class="input-group">
                                <input type="email" name="Email" value="@Model?.Email" class="form-control" placeholder="Enter your email" />
                                <i class="bi bi-envelope input-group-icon"></i>
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Phone Number</label>
                            <div class="input-group">
                                <input type="tel" name="Phone" value="@Model?.Phone" class="form-control" placeholder="Enter your phone number" />
                                <i class="bi bi-telephone input-group-icon"></i>
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Specialization</label>
                            <div class="input-group">
                                <input type="text" name="Specialization" value="@Model?.Specialization" class="form-control" placeholder="Enter your specialization" />
                                <i class="bi bi-stethoscope input-group-icon"></i>
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Consultation Fee</label>
                            <div class="input-group">
                                <input type="number" name="ConsultationFee" value="@Model?.ConsultationFee" class="form-control" placeholder="Enter consultation fee" />
                                <i class="bi bi-currency-dollar input-group-icon"></i>
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Years of Experience</label>
                            <div class="input-group">
                                <input type="text" name="yearsExperience" value="@Model?.yearsExperience" class="form-control" placeholder="Enter years of experience" />
                                <i class="bi bi-calendar-event input-group-icon"></i>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Biography</label>
                        <textarea name="Biography" class="form-control" rows="4" placeholder="Tell us about yourself...">@Model?.Biography</textarea>
                    </div>

                    <!-- Password Section -->
                    <div class="form-section-title">
                        <i class="bi bi-shield-lock"></i>
                        Change Password (Optional)
                    </div>
                    
                    <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px;">
                        <div class="form-group">
                            <label class="form-label">Current Password</label>
                            <div class="input-group">
                                <input type="password" name="currentPassword" class="form-control" placeholder="Leave empty to keep current" />
                                <i class="bi bi-lock input-group-icon"></i>
                            </div>
                            <p class="password-optional">Only required if changing password</p>
                        </div>

                        <div class="form-group">
                            <label class="form-label">New Password</label>
                            <div class="input-group">
                                <input type="password" name="newPassword" class="form-control" placeholder="Leave empty to keep current" />
                                <i class="bi bi-key input-group-icon"></i>
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Confirm New Password</label>
                            <div class="input-group">
                                <input type="password" name="confirmPassword" class="form-control" placeholder="Leave empty to keep current" />
                                <i class="bi bi-check-circle input-group-icon"></i>
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="btn-primary">
                        <i class="bi bi-save"></i>Save All Changes
                    </button>
                </form>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="error-message">
                    <ul>
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

        </div>
    </div>

</div>

<script>
function previewImage(input) {
    if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = function(e) {
            const avatar = document.querySelector('.profile-avatar');
            const existingImg = avatar.querySelector('img');
            const existingText = avatar.querySelector('span');
            const editIcon = avatar.querySelector('.profile-avatar-edit');
            
            // Clear existing content
            avatar.innerHTML = '';
            
            // Add new image
            const img = document.createElement('img');
            img.src = e.target.result;
            img.alt = 'Profile Image';
            img.onerror = function() {
                this.style.display = 'none';
                const text = document.createElement('span');
                text.textContent = '@initials';
                avatar.appendChild(text);
            };
            avatar.appendChild(img);
            
            // Add edit icon back
            avatar.appendChild(editIcon);
        }
        reader.readAsDataURL(input.files[0]);
    }
}
</script>

@section Scripts {
}