@model MedicalRecord
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Medical Record – Rayaah Clinic</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/dashboard.css" />
</head>
<body>
<div class="shell">

    @Html.Partial("_Sidebar")

    <!-- Main -->
    <div class="main">
      <header class="topbar">
    <form method="get" asp-controller="MedicalRecords" asp-action="Index" style="flex-grow: 1; display: flex;">
        <div class="search-bar" style="width: 100%;">
            <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 5 5"/></svg>
            <input type="search" name="search" value="@Context.Request.Query["search"]" placeholder="Search medical records..." style="width: 100%; border: none; outline: none; background: transparent;" onchange="this.form.submit()" />
        </div>
    </form>
    
      </header>

      <div class="content">
        <div style="margin-bottom: 8px;">
            <a asp-controller="MedicalRecords" asp-action="Index" style="text-decoration:none; font-size:13px; font-weight:700; color:#0284c7; display:inline-flex; align-items:center; gap:6px;">
                <i class="bi bi-arrow-left"></i> Back to Medical Records
            </a>
        </div>

        <div class="page-title">
            <h1>Edit Medical Record</h1>
            <p>Update consultation details and prescription</p>
        </div>

        <form asp-controller="MedicalRecords" asp-action="CurrentEdit" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="AppointmentId" />
            <input type="hidden" asp-for="CreatedAt" />
            <div asp-validation-summary="All" class="text-danger" style="margin-bottom:12px; font-size:12px; font-weight:700; list-style:none;"></div>

            <div class="form-card" style="margin-top:0;">
                <div style="display: flex; align-items: center; gap: 16px; margin-bottom: 24px; padding-bottom: 20px; border-bottom: 1px solid #f1f5f9;">
                    <div style="width: 56px; height: 56px; border-radius: 50%; background: linear-gradient(135deg, #0d9488 0%, #0f766e 100%); display: grid; place-items: center; color: white; font-weight: 800; font-size: 18px;">MR</div>
                    <div>
                        <h2 style="font-size: 18px; font-weight: 800; color: #0f172a; margin: 0;">Medical Record #@Model.Id</h2>
                        <p style="font-size: 13px; color: #64748b; margin: 4px 0 0;">Created: @Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</p>
                    </div>
                </div>

                @if (Model.Appointment != null)
                {
                    <div style="margin-bottom: 20px; padding: 12px 16px; background: #f0f9ff; border: 1px solid #bae6fd; border-radius: 8px;">
                        <strong style="color: #0c4a6e; font-size: 13px;">Patient: @Model.Appointment.Patient?.Name</strong>
                        <p style="margin: 4px 0 0; color: #0369a1; font-size: 11px;">Dr. @Model.Appointment.Doctor?.Name · @Model.Appointment.AppointmentDate.ToString("yyyy-MM-dd HH:mm")</p>
                    </div>
                }

                <div class="field">
                    <label asp-for="Diagnosis">Diagnosis</label>
                    <textarea asp-for="Diagnosis" rows="4"></textarea>
                    <span asp-validation-for="Diagnosis" class="text-danger" style="font-size:11px;"></span>
                </div>

                <div class="field">
                    <label asp-for="Prescription">Prescription</label>
                    <textarea asp-for="Prescription" rows="6"></textarea>
                    <span asp-validation-for="Prescription" class="text-danger" style="font-size:11px;"></span>
                </div>

                <div class="field">
                    <label asp-for="DoctorNotes">Doctor Notes</label>
                    <textarea asp-for="DoctorNotes" rows="4"></textarea>
                    <span asp-validation-for="DoctorNotes" class="text-danger" style="font-size:11px;"></span>
                </div>

                <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 24px; padding-top: 16px; border-top: 1px solid #f1f5f9;">
                    <a asp-controller="MedicalRecords" asp-action="Index" style="text-decoration:none; display:inline-flex; align-items:center; justify-content:center; height:44px; padding:0 24px; border-radius:12px; border:1.5px solid #e2e8f0; background:#fff; font-size:14px; font-weight:700; color:#64748b;">
                        Cancel
                    </a>
                    <button type="submit" class="create-btn" style="width:auto; padding:0 32px; border:none; cursor:pointer;">
                        <i class="bi bi-check-circle-fill"></i> Save Changes
                    </button>
                </div>
            </div>
        </form>
      </div>
    </div>
</div>
</body>
</html>