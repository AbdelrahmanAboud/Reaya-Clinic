@model List<MedicalRecord>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Medical Records – Rayaah Clinic</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/dashboard.css" />
</head>
<body>
<div class="shell">

    @Html.Partial("_Sidebar")

    <!-- Main -->
    <div class="main">
      <header class="topbar">
    <form method="get" asp-controller="MedicalRecords" asp-action="Index" style="flex-grow: 1; display: flex;">
        <div class="search-bar" style="width: 100%;">
            <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 5 5"/></svg>
            <input type="search" name="search" value="@Context.Request.Query["search"]" placeholder="Search medical records by diagnosis, prescription, patient..." style="width: 100%; border: none; outline: none; background: transparent;" onchange="this.form.submit()" />
        </div>
    </form>
    
      </header>

      <div class="content">
        <div class="page-title">
            <h1>Medical Records</h1>
            <p>Manage all consultation records and prescriptions</p>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px;">
		@foreach(MedicalRecord medicalRecord in Model){
    <article style="background: white; border-radius: 16px; padding: 20px; border: 1px solid #e8edf3; box-shadow: 0 2px 8px rgba(0,0,0,0.04);">
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;">
            <div style="width: 44px; height: 44px; border-radius: 50%; background: linear-gradient(135deg, #0d9488 0%, #0f766e 100%); display: grid; place-items: center; color: white; font-weight: 800; font-size: 13px;">MR</div>                 
            <div>
                <h2 style="font-size: 15px; font-weight: 700; color: #0f172a; margin: 0;">
                    <a asp-controller="MedicalRecords" asp-action="Details" asp-route-id="@medicalRecord.Id" style="color: inherit; text-decoration: none;">Record #@medicalRecord.Id</a>
                </h2>
                <em style="font-size: 12px; color: #64748b;">@medicalRecord.CreatedAt.ToString("yyyy-MM-dd HH:mm")</em>
            </div>
        </div>
        <p style="font-size: 13px; color: #475569; margin-bottom: 12px;">@medicalRecord.Diagnosis</p>
        <div style="display: flex; gap: 12px; margin-bottom: 16px; font-size: 12px; color: #64748b;">
            <span><b>👤</b> @(medicalRecord.Appointment?.Patient?.Name ?? "Unknown")</span>
            <span><b>👨‍⚕️</b> @(medicalRecord.Appointment?.Doctor?.Name ?? "Unknown")</span>
        </div>
        <div style="display: flex; gap: 8px;">
            <a asp-controller="MedicalRecords" asp-action="Details" asp-route-id="@medicalRecord.Id" class="patient-link" style="flex: 1; justify-content: center;">
                <i class="bi bi-file-medical"></i> Details
            </a>
            <a asp-controller="MedicalRecords" asp-route-id="@medicalRecord.Id" asp-action="Edit" class="icon-btn" style="border: 1px solid #e2e8f0;"><i class="bi bi-pencil-square"></i></a>
            <a asp-controller="MedicalRecords" asp-route-id="@medicalRecord.Id" asp-action="Delete" class="icon-btn" style="border: 1px solid #fecaca; background: #fef2f2; color: #dc2626;"><i class="bi bi-trash"></i></a>
        </div>
    </article>
}
		</div>
      </div>
    </div>
</div>
</body>
</html>