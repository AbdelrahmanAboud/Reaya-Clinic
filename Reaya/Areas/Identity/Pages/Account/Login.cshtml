@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div class="auth-page">
    <div class="auth-topbar">
        <a class="auth-brand" asp-area="" asp-controller="Home" asp-action="Index"><span class="brand-mark"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12h4l2-5 3 10 2-5h7" /></svg></span> Reaya</a>
        <a class="back-home" asp-area="" asp-controller="Home" asp-action="Index">Back to home</a>
    </div>
    <div class="auth-grid">
        <section class="auth-card">
            <div class="secure-pill"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10" width="14" height="10" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg> Secure patient access</div>
            <h1>Welcome back</h1>
            <p class="auth-lead">Sign in to manage your appointments and continue your care journey.</p>
            <form id="account" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div asp-validation-summary="ModelOnly" class="validation-message" role="alert"></div>
                <div class="auth-field"><label asp-for="Input.Email">Email address</label><div class="field-input"><span class="field-icon"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m4 7 8 6 8-6" /></svg></span><input asp-for="Input.Email" autocomplete="off" aria-required="true" placeholder="you@example.com" /></div><span asp-validation-for="Input.Email" class="validation-message"></span></div>
                <div class="auth-field"><div class="field-label-row"><label asp-for="Input.Password">Password</label><a id="forgot-password" asp-page="./ForgotPassword">Forgot password?</a></div><div class="field-input"><span class="field-icon"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10" width="14" height="10" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg></span><input asp-for="Input.Password" autocomplete="off" aria-required="true" placeholder="Enter your password" /><button type="button" class="password-toggle" data-password-toggle="Input_Password" aria-label="Show password" aria-pressed="false"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z" /><circle cx="12" cy="12" r="2.5" /></svg></button></div><span asp-validation-for="Input.Password" class="validation-message"></span></div>
                <button id="login-submit" type="submit" class="auth-submit">Sign in <span><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13m-6-6 6 6-6 6" /></svg></span></button>
            </form>
            <p class="auth-switch">New to Reaya? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Create an account</a></p>
            <a id="resend-confirmation" class="resend-link" asp-page="./ResendEmailConfirmation">Resend email confirmation</a>
        </section>
        <aside class="auth-story">
            <p class="eyebrow">YOUR CARE, CONNECTED</p>
            <h2>Everything you need, in one place</h2>
            <p>Sign in to book visits, view your upcoming appointments, and keep your patient details up to date.</p>
            <div class="benefit-list">
                <div><span><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v14H4z" /><path d="M8 3v4m8-4v4M4 10h16" /></svg></span><strong>Book appointments<small>Find the right doctor and time for you.</small></strong></div>
                <div><span><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 5 6v5c0 4.5 3 8.2 7 10 4-1.8 7-5.5 7-10V6l-7-3Z" /><path d="m9 12 2 2 4-4" /></svg></span><strong>Your details stay protected<small>Access your care information securely.</small></strong></div>
                <div><span><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 1 0 16 0 8 8 0 1 0-16 0Z" /><path d="M12 8v4l3 2" /></svg></span><strong>Stay on schedule<small>Keep every visit easy to follow.</small></strong></div>
            </div>
        </aside>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
