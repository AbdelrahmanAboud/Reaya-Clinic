@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot your password?";
}

<div class="auth-page">
    <div class="auth-topbar">
        <a class="auth-brand" asp-area="" asp-controller="Home" asp-action="Index"><span class="brand-mark"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12h4l2-5 3 10 2-5h7" /></svg></span> Reaya</a>
        <a class="back-home" asp-area="" asp-controller="Home" asp-action="Index">Back to home</a>
    </div>
    <div class="auth-grid support-grid">
        <section class="auth-card">
            <div class="secure-pill"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10" width="14" height="10" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg> Account recovery</div>
            <h1>Reset your password</h1>
            <p class="auth-lead">Enter the email address connected to your Reaya account and we'll send you a secure reset link.</p>
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="validation-message" role="alert"></div>
                <div class="auth-field">
                    <label asp-for="Input.Email">Email address</label>
                    <div class="field-input"><span class="field-icon"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m4 7 8 6 8-6" /></svg></span><input asp-for="Input.Email" autocomplete="username" aria-required="true" placeholder="you@example.com" /></div>
                    <span asp-validation-for="Input.Email" class="validation-message"></span>
                </div>
                <button type="submit" class="auth-submit">Send Reset Link <span><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13m-6-6 6 6-6 6" /></svg></span></button>
            </form>
            <p class="auth-switch"><a asp-page="./Login">← Back to sign in</a></p>
        </section>
        <aside class="auth-story support-story">
            <p class="eyebrow">SECURE RECOVERY</p>
            <h2>We'll help you get back in</h2>
            <p>Your account and medical information stay protected while you recover access.</p>
            <div class="benefit-list">
                <div><span><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m4 7 8 6 8-6" /></svg></span><strong>Check your inbox<small>Look for an email from the Reaya clinic.</small></strong></div>
                <div><span><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 5 6v5c0 4.5 3 8.2 7 10 4-1.8 7-5.5 7-10V6l-7-3Z" /><path d="m9 12 2 2 4-4" /></svg></span><strong>Use the secure link<small>The reset link will guide you to a new password.</small></strong></div>
                <div><span><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></span><strong>Return to your care<small>Sign in and continue managing your visits.</small></strong></div>
            </div>
        </aside>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
