@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="auth-page">
    <div class="auth-topbar">
        <a class="auth-brand" asp-area="" asp-controller="Home" asp-action="Index"><span class="brand-mark"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12h4l2-5 3 10 2-5h7" /></svg></span> Reaya</a>
        <a class="back-home" asp-area="" asp-controller="Home" asp-action="Index">Back to home</a>
    </div>
    <div class="auth-grid register-grid">
        <section class="auth-card">
            <h1>Create your account</h1>
            <p class="auth-lead">Register once and book appointments in under a minute.</p>
            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div asp-validation-summary="ModelOnly" class="validation-message" role="alert"></div>
                <div class="auth-field"><label asp-for="Input.FullName">Full name</label><div class="field-input"><span class="field-icon"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3" /><path d="M5 20a7 7 0 0 1 14 0" /></svg></span><input asp-for="Input.FullName" autocomplete="name" aria-required="true" placeholder="Sarah Ahmed" /></div><span asp-validation-for="Input.FullName" class="validation-message"></span></div>
                <div class="auth-field"><label asp-for="Input.PhoneNumber">Phone number</label><div class="field-input"><span class="field-icon"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h3l2 5-2 1.5a13 13 0 0 0 5.5 5.5L16 13l5 2v3c0 1.1-.9 2-2 2C10.7 20 4 13.3 4 5a2 2 0 0 1 2-2Z" /></svg></span><input asp-for="Input.PhoneNumber" autocomplete="tel" aria-required="true" placeholder="+20 100 123 4567" /></div><span asp-validation-for="Input.PhoneNumber" class="validation-message"></span></div>
                <div class="profile-field-grid">
                    <div class="auth-field"><label asp-for="Input.Gender">Gender</label><div class="field-input profile-input" data-select-picker><span class="field-icon"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3" /><path d="M3.5 20a5.5 5.5 0 0 1 11 0M16 4h5m-2.5-2.5V7" /></svg></span><select asp-for="Input.Gender" aria-required="true"><option value="">Select</option><option value="Female">Female</option><option value="Male">Male</option></select></div><span asp-validation-for="Input.Gender" class="validation-message"></span></div>
                    <div class="auth-field"><label asp-for="Input.DateOfBirth">Date of birth</label><div class="field-input profile-input"><span class="field-icon"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M8 3v4m8-4v4M3 10h18" /></svg></span><input asp-for="Input.DateOfBirth" type="date" aria-required="true" /></div><span asp-validation-for="Input.DateOfBirth" class="validation-message"></span></div>
                </div>
                <div class="auth-field"><label asp-for="Input.Address">Address</label><div class="field-input profile-input profile-textarea"><span class="field-icon field-icon-top"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s7-5.3 7-11a7 7 0 1 0-14 0c0 5.7 7 11 7 11Z" /><circle cx="12" cy="10" r="2.2" /></svg></span><textarea asp-for="Input.Address" rows="3" aria-required="true" placeholder="Street, area, city"></textarea></div><span asp-validation-for="Input.Address" class="validation-message"></span></div>
                <div class="auth-field"><label asp-for="Input.BloodType">Blood type</label><div class="field-input profile-input" data-select-picker><span class="field-icon"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3S6 10 6 14a6 6 0 0 0 12 0c0-4-6-11-6-11Z" /><path d="M9 15a3 3 0 0 0 3 3" /></svg></span><select asp-for="Input.BloodType" aria-required="true"><option value="">Select blood type</option><option value="A+">A+</option><option value="A-">A-</option><option value="B+">B+</option><option value="B-">B-</option><option value="AB+">AB+</option><option value="AB-">AB-</option><option value="O+">O+</option><option value="O-">O-</option></select></div><span asp-validation-for="Input.BloodType" class="validation-message"></span></div>
                <div class="auth-field"><label asp-for="Input.Email">Email address</label><div class="field-input"><span class="field-icon"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m4 7 8 6 8-6" /></svg></span><input asp-for="Input.Email" autocomplete="username" aria-required="true" placeholder="you@example.com" /></div><span asp-validation-for="Input.Email" class="validation-message"></span></div>
                <div class="auth-field"><label asp-for="Input.Password">Password</label><div class="field-input"><span class="field-icon"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10" width="14" height="10" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg></span><input asp-for="Input.Password" autocomplete="new-password" aria-required="true" placeholder="At least 8 characters" /><button type="button" class="password-toggle" data-password-toggle="Input_Password" aria-label="Show password" aria-pressed="false"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z" /><circle cx="12" cy="12" r="2.5" /></svg></button></div><span asp-validation-for="Input.Password" class="validation-message"></span></div>
                <div class="auth-field"><label asp-for="Input.ConfirmPassword">Confirm password</label><div class="field-input"><span class="field-icon"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10" width="14" height="10" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg></span><input asp-for="Input.ConfirmPassword" autocomplete="new-password" aria-required="true" placeholder="Repeat your password" /><button type="button" class="password-toggle" data-password-toggle="Input_ConfirmPassword" aria-label="Show password confirmation" aria-pressed="false"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z" /><circle cx="12" cy="12" r="2.5" /></svg></button></div><span asp-validation-for="Input.ConfirmPassword" class="validation-message"></span></div>
                <div class="account-note"><span>ⓘ</span> Registration automatically creates a patient profile for you. Doctor and staff accounts are set up by the clinic administration.</div>
                <button id="registerSubmit" type="submit" class="auth-submit">Create Patient Account <span><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13m-6-6 6 6-6 6" /></svg></span></button>
            </form>
            <p class="auth-switch">Already have an account? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Log in</a></p>
        </section>
        <aside class="auth-story register-story">
            <p class="eyebrow">PATIENT REGISTRATION</p>
            <h2>Your care, one secure account</h2>
            <p>A Reaya patient account lets you book visits, track upcoming and past appointments, and keep your details up to date - all from your phone.</p>
            <div class="benefit-list">
                <div><span><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 5 6v5c0 4.5 3 8.2 7 10 4-1.8 7-5.5 7-10V6l-7-3Z" /><path d="m9 12 2 2 4-4" /></svg></span><strong>Book in 4 steps<small>Pick a department, doctor, time and confirm.</small></strong></div>
                <div><span><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 5 6v5c0 4.5 3 8.2 7 10 4-1.8 7-5.5 7-10V6l-7-3Z" /><path d="m9 12 2 2 4-4" /></svg></span><strong>Track every visit<small>Status badges keep upcoming and past appointments clear.</small></strong></div>
                <div><span><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 5 6v5c0 4.5 3 8.2 7 10 4-1.8 7-5.5 7-10V6l-7-3Z" /><path d="m9 12 2 2 4-4" /></svg></span><strong>Privacy by default<small>Your medical details stay between you and your clinic.</small></strong></div>
            </div>
        </aside>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
